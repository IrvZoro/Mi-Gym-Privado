// Mapa: id de ejercicio -> pose
const EXERCISE_POSE = {
  p1:"press_horizontal", p2:"press_incline", p3:"fly", p4:"pushup", p5:"pushup", p6:"press_horizontal", p7:"press_horizontal",
  e1:"pull_vertical", e2:"pull_horizontal", e3:"pull_vertical", e4:"pull_horizontal", e5:"pullover", e6:"pull_horizontal", e7:"superman",
  h1:"press_vertical", h2:"lateral_raise", h3:"press_vertical", h4:"rear_fly", h5:"pushup", h6:"lateral_raise",
  b1:"curl", b2:"curl", b3:"triceps_extension", b4:"triceps_extension", b5:"dips", b6:"curl", b7:"pushup",
  l1:"squat", l2:"leg_press", l3:"hinge", l4:"leg_extension", l5:"leg_curl", l6:"lunge", l7:"squat", l8:"lunge",
  g1:"hip_thrust", g2:"hip_thrust", g3:"hip_thrust", g4:"hip_thrust",
  a1:"plank", a2:"hanging_leg_raise", a3:"ab_rollout", a4:"crunch", a5:"crunch",
  c1:"calf_raise", c2:"calf_raise",
};

function getPoseSVG(exId){
  const key = EXERCISE_POSE[exId] || "plank";
  return POSES[key] || POSES.plank;
}
