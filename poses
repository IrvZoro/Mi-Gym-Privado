// ============================================================
// FORJA — Pictogramas de ejercicios (siluetas tipo señalética de gym)
// Estilo: figura de palo minimalista, color heredado (currentColor)
// ============================================================

function figureSVG(headX, headY, lines, extra){
  const lineTags = lines.map(l =>
    `<line x1="${l[0]}" y1="${l[1]}" x2="${l[2]}" y2="${l[3]}" stroke="currentColor" stroke-width="7" stroke-linecap="round"/>`
  ).join("");
  return `<svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" class="pose-svg">
    ${extra || ""}
    <circle cx="${headX}" cy="${headY}" r="9" fill="currentColor"/>
    ${lineTags}
  </svg>`;
}

